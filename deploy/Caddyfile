{
	default_sni {$KANAME_HOST}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

(app_site) {
	reverse_proxy {args[0]} {
		header_up -Authorization
	}
}

{$PUBLIC_HOST} {
	map {http.request.header.Cookie} {tsudoi_cookie_0} {
		"~(?:^|;[ ]*)tsudoi_session=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {tsudoi_cookie_1} {
		"~(?:^|;[ ]*)kaname_flow_tsudoi=([^;]+)" "${1}"
		default ""
	}
	request_header Cookie "tsudoi_session={tsudoi_cookie_0}; kaname_flow_tsudoi={tsudoi_cookie_1}"

	handle /health {
		reverse_proxy tsudoi:8791
	}
	handle {
		import app_site tsudoi:8791
	}
}

{$PUBLIC_HOST}:8443 {
	map {http.request.header.Cookie} {hibiki_cookie_0} {
		"~(?:^|;[ ]*)hibiki_session=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {hibiki_cookie_1} {
		"~(?:^|;[ ]*)hibiki_oidc=([^;]+)" "${1}"
		default ""
	}
	request_header Cookie "hibiki_session={hibiki_cookie_0}; hibiki_oidc={hibiki_cookie_1}"

	@mcp path /mcp /api/uploads/*
	handle @mcp {
		reverse_proxy hibiki:8790
	}
	@jobDownload {
		path /api/jobs/*/download
		header Authorization "Bearer *"
	}
	handle @jobDownload {
		reverse_proxy hibiki:8790
	}
	handle {
		import app_site hibiki:8790
	}
}

{$PUBLIC_HOST}:8444 {
	map {http.request.header.Cookie} {douga_cookie_0} {
		"~(?:^|;[ ]*)__Secure-authjs\.session-token=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {douga_cookie_1} {
		"~(?:^|;[ ]*)__Secure-authjs\.callback-url=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {douga_cookie_2} {
		"~(?:^|;[ ]*)__Secure-authjs\.pkce\.code_verifier=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {douga_cookie_3} {
		"~(?:^|;[ ]*)__Secure-authjs\.state=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {douga_cookie_4} {
		"~(?:^|;[ ]*)__Secure-authjs\.nonce=([^;]+)" "${1}"
		default ""
	}
	map {http.request.header.Cookie} {douga_cookie_5} {
		"~(?:^|;[ ]*)__Host-authjs\.csrf-token=([^;]+)" "${1}"
		default ""
	}
	request_header Cookie "__Secure-authjs.session-token={douga_cookie_0}; __Secure-authjs.callback-url={douga_cookie_1}; __Secure-authjs.pkce.code_verifier={douga_cookie_2}; __Secure-authjs.state={douga_cookie_3}; __Secure-authjs.nonce={douga_cookie_4}; __Host-authjs.csrf-token={douga_cookie_5}"

	handle /api/mcp {
		reverse_proxy douga:3000
	}
	handle {
		import app_site douga:3000
	}
}

