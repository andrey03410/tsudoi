{$PUBLIC_HOST}:8446 {
  redir https://{$KANAME_HOST}:8446{uri} 302
}

(kaname_tls) {
  tls {
    issuer acme {
      profile shortlived
      disable_tlsalpn_challenge
    }
  }
}

https://{$KANAME_HOST}:8446 {
  import kaname_tls
  @internal path /internal/*
  respond @internal 404
  reverse_proxy kaname:3000 {
    header_up Cookie "(^|;[ ]*)(AUTH_SESSION_ID|KC_RESTART|KEYCLOAK_[A-Z_]+)=[^;]*" ""
  }
}

https://{$KANAME_HOST}:8447 {
  import kaname_tls
  @login path /realms/kaname/* /resources/* /.well-known/*
  handle @login {
    reverse_proxy kaname-id:8080 {
      header_up Cookie "(^|;[ ]*)__Host-kaname-(session|flow)=[^;]*" ""
    }
  }
  respond 404
}
